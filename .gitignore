paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.tmp/

# never commit credentials
.env
*.env
keys*

# working notes and stray view renders (not part of the release)
STATUS.md
_view_*.png
paper/main_anon.tex
paper/main_anon.aux
paper/main_anon.log
paper/main_anon.out
paper/main_anon.bbl
paper/main_anon.blg
