paper/main_postprint.out
paper/main_postprint.bbl
paper/main_postprint.blg

# Built PDFs that are NOT the posted copy. IEEE permits the accepted article on the
# author's own repository, but the posted copy must carry the copyright notice. Only
# paper/main_postprint.pdf does, so it is the one this repo distributes. The others
# are regenerated by reproduce.sh and build_anon.sh.
paper/main.pdf
paper/main_anon.pdf
